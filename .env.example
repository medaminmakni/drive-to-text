# Copy this file to .env and fill in the values. Never commit .env.

# Google Drive API key (Google Cloud Console > APIs & Services > Credentials).
# Only public folders are read, so no OAuth login is needed. See README, Setup.
GOOGLE_API_KEY=

# Files bigger than this are marked as failed instead of downloaded.
MAX_FILE_SIZE_MB=25
# Files processed in parallel inside one batch.
MAX_WORKERS=3
# Timeout for Google Drive calls, in seconds.
REQUEST_TIMEOUT=30

# OCR language used when none is chosen (Tesseract codes: eng, fra, ara, or e.g. ara+fra).
OCR_DEFAULT_LANG=eng
# A PDF page with fewer characters than this is treated as scanned and sent to OCR.
PDF_MIN_CHARS_PER_PAGE=20
# Resolution used to render scanned PDF pages before OCR.
OCR_DPI=300
# Pages whose OCR confidence (0-100) is below this are flagged "needs review".
OCR_REVIEW_THRESHOLD=70
# Limits, because files come from a folder we do not control (0 = no limit):
# OCR time per image or scanned page, in seconds. A page over the limit is left empty and flagged.
OCR_TIMEOUT_S=60
# Pages read per PDF; the rest are skipped with a warning.
MAX_PDF_PAGES=100
# Images (and rendered PDF pages) larger than this are refused or rendered smaller.
MAX_IMAGE_MEGAPIXELS=50
# Optional: folder with other Tesseract models (for example tessdata_best). Empty = Tesseract's own.
TESSDATA_DIR=

# Optional AI OCR engine through a local Ollama (run: ollama pull glm-ocr).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=glm-ocr
